{
  "name": "physics-digital-hub",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "verify": "node scripts/verify-project.mjs",
    "prebuild": "npm run verify",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --pretty",
    "check": "npm run verify && tsc -b --pretty",
    "lint": "npm run check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.87.1",
    "@types/three": "^0.187.0",
    "@vimeo/player": "^2.26.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "typescript": "~5.9.3",
    "vite": "^7.2.2"
  },
  "description": "S.K.S Public School Annual Exhibition Dual Axis Solar Tracker (3D Working Model) digital hub",
  "engines": {
    "node": ">=22.12.0"
  },
